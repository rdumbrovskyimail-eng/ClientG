# ====================================================================
# Сборка Gradle и временные кэши
# ====================================================================
.gradle/
build/
**/build/
bin/
out/
.kotlin/

# ====================================================================
# ПОЛНЫЙ ЗАПРЕТ БИНАРНИКОВ В GIT (Zero-Binary Policy)
# ====================================================================
# Исполняемый файл Gradle Wrapper (скачивается автоматически скриптом)
gradle/wrapper/gradle-wrapper.jar

# Все скомпилированные JAR, AAR и сборочные пакеты Android
*.jar
*.war
*.ear
*.aar
*.apk
*.aab
*.class

# ====================================================================
# Android Studio / IntelliJ IDEA / VS Code
# ====================================================================
.idea/
*.iml
*.ipr
*.iws
.navigation/
.vscode/

# ====================================================================
# Безопасность и конфигурация среды (SDK, API Ключи)
# ====================================================================
# Пути к Android SDK на конкретной машине
local.properties

# Переменные окружения и ключи Gemini API
.env
.env.*
*.key
*.keystore
*.jks

# ====================================================================
# Служебные файлы операционных систем
# ====================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

