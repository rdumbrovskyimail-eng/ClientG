# ====================================================================
# Поведение по умолчанию для всех текстовых файлов
# ====================================================================
# Автоматическое определение текста и принудительное сохранение LF в репозитории
* text=auto eol=lf

# ====================================================================
# Скрипты сборщика (КРИТИЧНО ДЛЯ СОВМЕСТИМОСТИ LINUX / CI / WINDOWS)
# ====================================================================
# gradlew ОБЯЗАН иметь окончания LF (защита от ошибки "\r: command not found" в CI)
gradlew text eol=lf
*.sh text eol=lf

# Файлы Windows Batch требуют CRLF для штатной работы в cmd.exe
gradlew.bat text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# ====================================================================
# Исходный код Kotlin и файлы конфигурации
# ====================================================================
*.kt text eol=lf diff=kotlin
*.kts text eol=lf diff=kotlin
*.properties text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.pro text eol=lf
*.md text eol=lf

# ====================================================================
# Бинарные файлы (защита от повреждения при коммите)
# ====================================================================
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.keystore binary
*.jks binary
*.jar binary
*.aar binary